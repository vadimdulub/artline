.DS_Store
.env
.env.local
.env.*
!.env.example
.idea/
.next/
node_modules/
test-results/
playwright-report/
apps/web/coverage/
dist/
bin/
*.log
*.tsbuildinfo
__pycache__/
*.pyc
/output/

# Local downloads and catalogue evidence stay on disk, outside source control.
content/imports/*
!content/imports/README.md
content/imports/*/cache/
docs/research/**/*.json
docs/research/**/*.jsonl
docs/research/**/*.csv
docs/research/**/snapshots/
docs/research/**/inventory*/
docs/research/**/captures/
docs/research/**/metadata/
docs/research/austrian-museums-20260916/source-preflight/

# Preserve raw research locally; version the human-readable research reports.
docs/research/**/*
!docs/research/**/
!docs/research/**/*.md
docs/research/**/snapshots/
docs/research/**/inventory*/
docs/research/**/captures/
docs/research/**/metadata/
docs/research/**/source-preflight/
docs/research/images-followup-20260916/nationalmuseum-discovery/
docs/research/overnight-images-20260915/walters/

# Artwork reproductions are served from Cloud Storage in production.
apps/web/public/assets/**/*.jpg
apps/web/public/assets/**/*.jpeg
apps/web/public/assets/**/*.png
apps/web/public/assets/**/*.webp
apps/web/public/assets/**/*.avif
apps/web/public/assets/**/*.gif

# Runtime credentials, database backups and Terraform state/plan files.
*.pem
*.key
*.dump
*.backup
*.tfplan
terraform.tfstate
terraform.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
