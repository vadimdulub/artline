PORT=8080
DATABASE_URL=postgres://localhost/artline?sslmode=disable
FRONTEND_ORIGIN=http://localhost:3000
ARTLINE_EDITOR_TOKEN=
ARTLINE_PUBLIC_RESEARCH_PREVIEW=false

# Local database + frontend automatically unlock member features without Google.
# Set ARTLINE_LOCAL_DEBUG=false only when testing the real OAuth flow locally.
# Production containers and Cloud Run always reject local debug.
# All four below are required together outside local debug.
# Use a separate Google Web application OAuth client for local OAuth tests.
ARTLINE_GOOGLE_CLIENT_ID=
ARTLINE_GOOGLE_CLIENT_SECRET=
ARTLINE_AUTH_COOKIE_KEY=
ARTLINE_AUTH_ORIGIN=
# Local origin: http://localhost:3000; production: https://artlines.org
# Redirect URI: <origin>/api/auth/google/callback
