API_INTERNAL_URL=http://localhost:8080
# Set this to the purchased HTTPS domain before release. No path or trailing query.
# Until configured, canonical URLs use the documented Cloud Run production origin.
ARTLINE_SITE_URL=
# Optional ownership tokens supplied by Google Search Console / Bing Webmaster Tools.
ARTLINE_GOOGLE_SITE_VERIFICATION=
ARTLINE_BING_SITE_VERIFICATION=
# Public site token from Cloudflare Web Analytics > Manage site > JS snippet.
# Configure on the production web service only; empty disables analytics.
# This is NOT a Cloudflare API key. Development and test builds never load it.
ARTLINE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
